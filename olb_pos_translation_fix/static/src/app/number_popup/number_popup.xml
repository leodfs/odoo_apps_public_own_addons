<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Both buttons wrote their label as a string expression ('Ok', 'Discard'),
         which QWeb never translates. Each label stays inside a <t>, so that the
         templates inheriting the popup still find it. -->
    <t t-name="olb_pos_translation_fix.NumberPopup" t-inherit="point_of_sale.NumberPopup" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('btn-primary')]/t" position="replace">
            <t t-esc="confirmButtonLabel"/>
        </xpath>
        <xpath expr="//button[hasclass('btn-secondary')]/t" position="replace">
            <t>Discard</t>
        </xpath>
    </t>
</templates>
