<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lf_pos_required_customer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <setting id="pos_required_customer" help="Enable this option to require the customer to be selected at the point of sale">
                    <field name="pos_required_customer"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
