<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lf_pos_extend_customer_name_button</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pos_extend_customer_name_button" string="Extend Customer Name on Button" help="Enable this option to display the full customer name on the button">
                    <field name="pos_extend_customer_name_button"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
