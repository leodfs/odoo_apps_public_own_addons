<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Right below the total, styled like the other amounts. -->
    <t t-name="olb_pos_items_count.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-total')]" position="after">
            <div class="pos-receipt-amount receipt-items-count">
                <span>Total Items</span>
                <span t-esc="env.utils.formatProductQty(order.itemCount, false)" class="pos-receipt-right-align font-monospace"/>
            </div>
        </xpath>
    </t>

</templates>
